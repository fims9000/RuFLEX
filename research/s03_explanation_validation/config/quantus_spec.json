{
  "schema_version": 1,
  "optional_dependency": "quantus==0.6.0",
  "required_for_product_runtime": false,
  "preflight": "synthetic_only_before_benchmark",
  "metrics": [
    {"name": "faithfulness_correlation", "class": "FaithfulnessCorrelation", "parameters": {"nr_runs": 10, "subset_size": 1, "perturb_baseline": "mean", "seed": 3003}, "direction": "lower_corrupt_is_worse", "epsilon": 1e-12},
    {"name": "max_sensitivity", "class": "MaxSensitivity", "parameters": {"nr_samples": 10, "lower_bound": 0.0, "upper_bound": 0.05, "seed": 3003}, "direction": "higher_corrupt_is_worse", "epsilon": 1e-12}
  ],
  "paired_detection_rule": "corrupt_score worsens relative to paired clean score in frozen direction by more than epsilon; no fitted cutoff"
}
