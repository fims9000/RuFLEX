    "COMBINED": {"components": ["IDENTITY", "REPLAY_INTEGRITY", "NATIVE_NUMERICAL", "EXTERNAL_QUANTUS"], "detection_rule": "OR over all applicable declared components"}
  },
  "repeatability_classification": "REPLAY_INTEGRITY; not a generic faithfulness metric"
}
