{
  "schema_version": 2,
  "datasets": ["ai4i_2020", "uci_bank_marketing", "wisconsin_diagnostic"],
  "models": {"logistic_regression": ["occlusion", "permutation_shap"], "decision_tree": ["occlusion", "tree_shap"], "random_forest": ["occlusion", "tree_shap"], "gradient_boosting": ["occlusion", "tree_shap"], "flat_neuro_fuzzy": ["occlusion", "integrated_gradients", "gradient_shap"]},
  "samples_per_dataset_model": 8,
